# MT5 Gateway environment example
# Copy to .env on the MT5 host and fill real values

API_KEY=replace_with_strong_api_key
MT5_ACCOUNT=12345678
MT5_PASSWORD=replace_with_mt5_password
MT5_SERVER=YourBroker-Server

# Optional terminal path used by api_gateway.py (Windows)
# MT5_PATH=C:\mt5\ExnessDemo\terminal64.exe

# Script config (start/stop scripts read this .env)
# BRIDGE_ROOT defaults to script folder when omitted
BRIDGE_ROOT=C:\mt5-bridge
MT5_DIR=C:\mt5\ExnessDemo
MT5_EXE=C:\mt5\ExnessDemo\terminal64.exe
