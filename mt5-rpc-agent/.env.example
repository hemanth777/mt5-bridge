# MT5 RPC Agent local config
MT5_RPC_API_KEY=replace_with_api_key
MT5_RPC_HOST=192.168.8.105
MT5_RPC_PORT=8080
MT5_RPC_SCHEME=http

# Optional: override full URL instead of host/port/scheme
# MT5_RPC_URL=http://192.168.8.105:8080/rpc

# Optional paths (defaults are this folder)
# MT5_RPC_REQUEST_JSON=./mt5_rpc_request.json
# MT5_RPC_OUTPUT_JSON=./mt5_rpc_output.json
